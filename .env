export KEY_FluxP=CDDAD9230C22E207B2AB2BD183E0D8C9439B21A2

gpg --export-secret-keys --armor "${KEY_FluxP}" |
kubectl create secret generic sops-gpg \
--namespace=flux-system \
--from-file=sops.asc=/dev/stdin

https://github.com/ZakariaZermani/gitops-lab-flux.git

flux create source git my-secrets \
--url=https://github.com/ZakariaZermani/gitops-lab-flux \
--branch=main \
--export > sops/my-secrets-git-repo.yaml

flux create kustomization my-secrets \
--source=my-secrets \
--path=./flux-system \
--prune=true \
--interval=10m \
--decryption-provider=sops \
--decryption-secret=sops-gpg \
--export > sops-my-secrets-ks.yaml


cat <<EOF > ./flux-system/.sops.yaml
creation_rules:
  - path_regex: .*.yaml
    encrypted_regex: ^(data|stringData)$
    pgp: ${KEY_FluxP}
EOF